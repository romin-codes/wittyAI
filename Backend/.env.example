# MongoDB connection string (MongoDB Atlas recommended for serverless)
MONGODB_URI=your-mongodb-connection-string

# OpenAI API key (used as fallback when AI_SERVICE_URL is unset on Vercel)
OPENAI_API_KEY=your-openai-api-key

# Python FastAPI AI service URL (defaults to http://localhost:8000 locally)
AI_SERVICE_URL=http://localhost:8000
